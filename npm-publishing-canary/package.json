{
  "name": "@agent-teams/npm-publishing-canary",
  "version": "0.0.2",
  "description": "Unsupported disposable fixture for organization npm OIDC publication qualification",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/ci-runner-sandbox-20261005.git",
    "directory": "npm-publishing-canary"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:release": "tsc -p tsconfig.release.json",
    "test:release": "node --test tests/release-candidate.test.ts tests/release-workflow.test.ts",
    "check:release": "npm run typecheck:release && npm run test:release",
    "release:status": "node scripts/version-release.ts --status",
    "release:version": "node scripts/version-release.ts",
    "release:check-pr": "node scripts/check-release-pr.ts",
    "release:check-source": "node scripts/check-release-source.ts"
  },
  "devDependencies": {
    "@agent-teams/release-checks": "0.1.0",
    "@changesets/cli": "3.0.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
